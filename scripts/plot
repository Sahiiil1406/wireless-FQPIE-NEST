set term postscript dashed color
set term postscript eps
 set output 'tc_ldelay.eps'
 set xlabel 'Time (Seconds)'
 set ylabel 'Queue Delay (ms)'
 set xrange [0:100]
 set xtics 0,10,100
 set yrange [0:*]
plot 'fq_codel_ldelay.dat' using 1:($2/1000) title 'fq_codel' with lines lt rgbcolor 'red', \
     'fq_codelpp_ldelay.dat' using 1:($2/1000) title 'fq_codel++' with lines lt rgbcolor 'blue'
set output

