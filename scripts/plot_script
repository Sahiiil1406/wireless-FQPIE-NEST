#TC plots

set term postscript dashed color
set term postscript eps
 set output 'tc_backlog.eps'
 set xlabel 'Time (Seconds)'
 set ylabel 'Backlog (Bytes)'
 set xrange [0:200]
 set xtics 0,25,200
 set yrange [0:70000]
 set ytics 1000,5000,70000
plot 'original_backlog.dat' using 1:2 title 'CoDel' with lines lt rgbcolor 'red', 'modified_backlog.dat' using 1:2 title 'CoDel++' with lines lt rgbcolor 'blue'
#plot 'modified_backlog.dat' using 1:2 title 'CoDel++' with lines lt rgbcolor "red"
set output

