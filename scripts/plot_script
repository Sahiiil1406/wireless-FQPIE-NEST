#Receiver_throughput
set term postscript dashed color
set term postscript eps
 set output 'Throughput.eps'
 set xlabel 'Time (Seconds)'
 set ylabel 'Throughput (Mbps)'
 set xrange [0:300]
 set xtics 0,25,300
 set yrange [0:10]
# set ytics 6,8,22
plot 'original_netperf_receiver.dat' using 1:2 title 'CoDel' with lines lt rgbcolor 'red', 'modified_netperf_receiver.dat' using 1:2 title 'CoDel++' with lines lt rgbcolor 'blue'
#plot 'modified_netperf.dat' using 1:2 title 'Modified_CoDel' with lines lt rgbcolor "red"
set output



#link utilization 
set term postscript dashed color
set term postscript eps
 set output 'link_utilization.eps'
 set xlabel 'Time (Seconds)'
 set ylabel 'Link Utilization (%)'
 set xrange [0:300]
 set xtics 0,25,300
 set yrange [0:100]
 set ytics 0,10,100
plot 'original_link_utilization.dat' using 1:2 title 'CoDel' with lines lt rgbcolor 'red', 'modified_link_utilization.dat' using 1:2 title 'CoDel++' with lines lt rgbcolor 'blue'

